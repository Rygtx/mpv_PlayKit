# native/ 下只跟踪源码、CMake 工程与 fetch-deps/build 脚本
native/build/
native/bin/
# 第三方依赖: fetch-deps.ps1 可重建 (NGX SDK / VapourSynth 头), 不入库
native/dependencies/
# 本地诊断测试与产物 (python 脚本/exe/截图/日志);可复用工具在 native/testkit/
native/tests/
# testkit 合成测试媒体 (testmedia.py 确定性生成, 单片 11-124MB 不入库)
native/testkit/media/
__pycache__/
# 本地路线图/进展文档, 不随仓库分发
native/PORTING.md
# 打包: 仓库内暂存的模型等大文件 (package.ps1 输入) 与 zip 输出
native/vendor/
native/dist/

# IDE 本地配置 (VSCode 生成的 cmake.sourceDirectory 为本机绝对路径, 不共享)
.vscode/
# 本地临时脚本与产物 (构建包装/截图脚本等), 不随仓库分发
Temp/

# AI 模型文件体积巨大 (nvngx_dlssnr.dll ~165MB), 随 Release 附件分发不入库
*.dll
!portable_config/**/*.dll

# 诊断收集脚本(误在仓库根运行时)的产物
诊断收集/
